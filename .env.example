# ============================================================
# QuantPilot — Environment Variables Template
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# Copy this file to .env.local for local development.
# ============================================================

# Supabase Authentication & PostgreSQL Database
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Google AI Studio (Free Tier Gemini API)
# Stored only in backend service or protected client-proxy
VITE_GEMINI_API_KEY=your-gemini-api-key-placeholder

# Market Data Service (Future Milestone)
# E.g. Alpha Vantage, Yahoo Finance, or local Python Quant service
VITE_MARKET_DATA_API_URL=http://localhost:8000/api/v1
VITE_MARKET_DATA_API_KEY=your-market-data-key-placeholder

# Application Environment Mode
VITE_APP_ENV=development
VITE_DEMO_MODE=true
